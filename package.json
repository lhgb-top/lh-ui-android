{
  "name": "@lh-ui/android",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "lh-ui 原生血脉 Android 端：Kotlin + Jetpack Compose UI 库（构建期工具脚本，非运行时）",
  "license": "Apache-2.0",
  "author": "lhgb <i@lhgb.top>",
  "homepage": "https://www.lhgb.top/lhui/android/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhgb-top/lh-ui-android.git"
  },
  "bugs": {
    "url": "https://github.com/lhgb-top/lh-ui-android/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "link:tokens": "node scripts/link-tokens.mjs",
    "link:tokens:check": "node scripts/link-tokens.mjs --check",
    "gen:sim": "node scripts/gen-sim-tokens.mjs",
    "docs:dev": "pnpm gen:sim && vitepress dev docs --port 5181",
    "docs:build": "pnpm gen:sim && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/sync-version.mjs",
    "release:push": "node scripts/push-release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "vite": "^5.4.21",
    "vitepress": "^1.6.4",
    "vue": "^3.5.13"
  },
  "sideEffects": false
}